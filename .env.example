# Local run (no Docker): DATABASE_URL=sqlite:///./progress.db and UPLOAD_DIR=./uploads
# Docker and Render: the disk is mounted at /var/data
# Do not set PORT; Render provides it
# For Docker on your own computer use ENV=development (a Secure cookie is not sent over http://localhost)
DATABASE_URL=sqlite:////var/data/progress.db
UPLOAD_DIR=/var/data/uploads
SECRET_KEY=change-me
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
FRONTEND_ORIGIN=https://your-frontend.onrender.com
MAX_UPLOAD_MB=10
TOTAL_CHAPTERS=5
INACTIVITY_DAYS=21
BACKUP_KEEP=7
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Page of the front end that reads ?token=... for password reset
FRONTEND_RESET_PATH=/reset-password
ENV=production
